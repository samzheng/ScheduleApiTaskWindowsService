<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="taskScheduler" type="ScheduledApiTaskWindowsService.Config.TaskSchedulerSection, ScheduledApiTaskWindowsService" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <!--
    任务配置说明：
    - name           任务名称（用于日志文件名，必填、唯一）
    - url            要调用的 API 地址（必填）
    - method         GET 或 POST，默认 GET
    - postData       POST 时的请求体，默认空
    - contentType    POST 时的 Content-Type，默认 application/json
    - timeoutSeconds 超时秒数，默认 60

    调度方式（scheduleType 三选一）：
    - Daily     每天 timeOfDay 运行一次，例：timeOfDay="02:30:00"
    - Monthly   每月 dayOfMonth 日 timeOfDay 运行一次（当月没有该日则取当月最后一天）
    - Interval  每隔 intervalSeconds 秒运行一次（服务启动后从下一个间隔开始运行）
  -->
  <taskScheduler>
    <apiTasks>
      <!-- 每天 02:00:00 运行 -->
      <task name="ResetAssignment"
            url="http://localhost:8080/api/resetAssignment"
            method="POST"
            postData="{&quot;mode&quot;:&quot;daily&quot;}"
            contentType="application/json"
            scheduleType="Daily"
            timeOfDay="02:00:00" />

      <!-- 每 5 秒运行一次 -->
      <task name="SyncData"
            url="http://localhost:8080/api/syncData"
            method="GET"
            scheduleType="Interval"
            intervalSeconds="5" />

      <!-- 每月 1 日 03:30:00 运行 -->
      <task name="MonthlyReport"
            url="http://localhost:8080/api/monthlyReport"
            method="POST"
            postData=""
            scheduleType="Monthly"
            dayOfMonth="1"
            timeOfDay="03:30:00" />
    </apiTasks>
  </taskScheduler>
</configuration>
